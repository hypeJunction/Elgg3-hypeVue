{
	"name": "hypejunction/hypevue",
	"version": "4.0.0",
	"type": "elgg-plugin",
	"description": "Vue.js bootstrap for Elgg",
	"homepage": "https://github.com/hypeJunction/Elgg3-hypeVue",
	"keywords": [
		"elgg",
		"plugin",
		"vue"
	],
	"license": "proprietary",
	"authors": [
		{
			"name": "Ismayil Khayredinov",
			"email": "ismayil.khayredinov@gmail.com"
		}
	],
	"extra": {
		"installer-name": "hypeVue",
		"elgg-plugin": {
			"id": "hypevue"
		}
	},
	"require": {
		"composer/installers": "^2.0",
		"elgg/elgg": "^4.0",
		"bower-asset/moment": "^2.22",
		"php": ">=8.1"
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://asset-packagist.org"
		}
	],
	"autoload": {
		"psr-0": {
			"": "classes/"
		}
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true
		}
	}
}
